# Server
PORT=5000
NODE_ENV=production

# Live frontend origin (no trailing slash) — required for CORS on Vercel
# Comma-separated list is supported if you have multiple frontends
FRONTEND_URL=https://construction-erp-frontend-six.vercel.app
# CLIENT_URL=https://construction-erp-frontend-six.vercel.app
# CORS_ORIGINS=https://another-frontend.example.com

# PostgreSQL — PRODUCTION (Vercel): use Supabase TRANSACTION pooler on port 6543
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Direct (non-pooled) connection for migrations/CLI only — port 5432
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Pool tuning (serverless defaults to 1)
# PG_POOL_MAX=1

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Security
ALLOW_PUBLIC_REGISTER=false
# RUN_SEED_ON_BOOT=false
