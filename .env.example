# Server
PORT=5000
NODE_ENV=development

# Frontend origin (no trailing slash) — used for CORS
# Local:
FRONTEND_URL=http://localhost:5173
# Production (set on host, not in git):
# FRONTEND_URL=https://your-frontend.example.com
# CLIENT_URL=https://your-frontend.example.com
# CORS_ORIGINS=https://preview-a.example.com,https://preview-b.example.com

# PostgreSQL
# LOCAL: Supabase session pooler on port 5432 is fine
# PRODUCTION (serverless / Vercel): use TRANSACTION pooler on port 6543
# Example local:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Example production runtime (host env only):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Direct connection for migrations/CLI — port 5432 (not the transaction pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Pool tuning (serverless defaults to 1; local defaults to 5)
# PG_POOL_MAX=5

# Auth — use a long random string in production; rotate if .env was ever committed
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Security
ALLOW_PUBLIC_REGISTER=false
RUN_SEED_ON_BOOT=false
