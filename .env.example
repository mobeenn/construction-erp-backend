# Server
PORT=5000
NODE_ENV=production

# Live frontend origin (no trailing slash) — required for CORS on Vercel
FRONTEND_URL=https://construction-erp-frontend-six.vercel.app
# Optional alias (also accepted by CORS)
# CLIENT_URL=https://construction-erp-frontend-six.vercel.app

# PostgreSQL (Supabase pooler recommended on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
